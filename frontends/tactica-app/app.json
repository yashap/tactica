{
  "expo": {
    "name": "Tactica",
    "slug": "tactica-app",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "tacticaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"]
  }
}
