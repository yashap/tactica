{
  "extends": "@tactica/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["react", "node"],
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["src", "app.config.ts"],
  "exclude": ["node_modules", "dist", "web-build", ".expo"]
}
