{
  "name": "@tactica/tactica-app",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "clean": "rm -rf .expo .turbo node_modules/.cache dist web-build",
    "serve": "expo start",
    "serve:web": "expo start --web",
    "web": "expo start --web --port 8081",
    "ios": "expo start --ios --port 8082",
    "android": "expo start --android --port 8083",
    "format": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@tactica/api-client-utils": "workspace:*",
    "@tactica/errors": "workspace:*",
    "@tactica/tactica-core-client": "workspace:*",
    "@tactica/tactica-core-contract": "workspace:*",
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@tanstack/react-query": "^5.62.16",
    "axios": "^1.11.0",
    "expo": "~52.0.42",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.20",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@tactica/eslint-config": "workspace:*",
    "@tactica/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.18",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  }
}
