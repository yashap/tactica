{
  "name": "@tactica/tactica-app",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "clean": "rm -rf .expo .turbo node_modules/.cache dist web-build",
    "serve": "expo start",
    "serve:web": "expo start --web",
    "web": "expo start --web --port 8081",
    "ios": "expo start --ios --port 8082",
    "android": "expo start --android --port 8083",
    "format": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tactica/api-client-utils": "workspace:*",
    "@tactica/errors": "workspace:*",
    "@tactica/tactica-core-client": "workspace:*",
    "@tactica/tactica-core-contract": "workspace:*",
    "@tanstack/react-query": "^5.106.1",
    "axios": "^1.21.0",
    "chess.js": "^1.4.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@tactica/eslint-config": "workspace:*",
    "@tactica/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3"
  }
}
