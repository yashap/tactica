{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "JSON_LOGS",
    "DATABASE_URL",
    "PORT",
    "HOST_NAME",
    "SUPERTOKENS_CORE_URL",
    "SUPERTOKENS_API_KEY",
    "TACTICA_WEB_URL",
    "TACTICA_CORE_URL",
    "WORKER_ENABLED",
    "IMPORT_MAX_MONTHS",
    "CHESSCOM_API_URL",
    "CHESSCOM_USER_AGENT",
    "STOCKFISH_PATH",
    "STOCKFISH_PORT",
    "STOCKFISH_URL",
    "ENGINE_THREADS",
    "ENGINE_HASH",
    "ANALYSIS_PORT",
    "ANALYSIS_DATABASE_URL",
    "INTERNAL_API_KEY",
    "ANALYSIS_SCAN_MOVETIME_MS",
    "ANALYSIS_DEEP_MOVETIME_MS",
    "ANALYSIS_MULTI_PV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "db:dump-fixtures": {
      "cache": false
    },
    "db:migrate-up": {
      "cache": false
    },
    "db:migrate-up:test": {
      "cache": false
    },
    "db:restore-fixtures": {
      "cache": false
    },
    "format": {
      "outputs": []
    },
    "lint": {
      "outputs": [],
      "dependsOn": []
    },
    "serve": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    }
  }
}
