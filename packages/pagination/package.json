{
  "name": "@tactica/pagination",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tactica/errors": "workspace:*",
    "js-base64": "^3.7.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tactica/eslint-config": "workspace:*",
    "@tactica/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
