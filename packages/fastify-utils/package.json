{
  "name": "@tactica/fastify-utils",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@tactica/errors": "workspace:*",
    "@tactica/logging": "workspace:*",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "supertokens-node": "^23.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tactica/eslint-config": "workspace:*",
    "@tactica/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  }
}
