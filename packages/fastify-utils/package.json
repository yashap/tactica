{
  "name": "@tactica/fastify-utils",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo",
    "format": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/formbody": "^9.0.1",
    "@tactica/correlation-id-propagator": "workspace:*",
    "@tactica/errors": "workspace:*",
    "@tactica/logging": "workspace:*",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "supertokens-node": "^24.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tactica/eslint-config": "workspace:*",
    "@tactica/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
